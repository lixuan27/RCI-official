{
  "domain": "trial",
  "titles": {"report": "Trial site record: {name}", "email": "Thread: {name}"},
  "email_domain": "trialnet.example",
  "types": {
    "A": {"kind": "site", "plural": "trial sites", "suffix": "Trial Site", "log_title": "TRIAL SITE LOG", "code_prefix": "TP",
          "stems1": ["Barley", "Oat", "Rye", "Flax", "Hop", "Millet", "Lentil", "Vetch", "Sainfoin", "Lucerne", "Spelt",
                     "Emmer", "Sorghum", "Quinoa", "Chickpea", "Mustard", "Canola", "Fescue", "Timothy", "Cocksfoot",
                     "Bluegrass", "Bentgrass", "Teasel", "Borage", "Phacelia", "Buckwheat", "Camelina", "Safflower"],
          "stems2": ["Down", "Lea", "Close", "Furlong", "Acre", "Leys"],
          "alias_forms": ["{stem}", "{stem} site"], "generic": ["the site", "this site"]},
    "B": {"kind": "farm", "plural": "partner farms", "suffix": "Farm", "log_title": "FARM LOG", "code_prefix": "PF",
          "stems1": ["Greywater", "Oxbow", "Highfold", "Longmire", "Redmoor", "Stonecross", "Westerby", "Eastleigh",
                     "Northam", "Southwold", "Coldharbour", "Fairlea", "Brightwell", "Deepdale", "Ashcombe", "Windrush"],
          "stems2": ["Hall", "Lodge", "Mains", "Steading", "House", "Grange"],
          "alias_forms": ["{stem}", "{stem} partner farm"], "generic": ["the farm", "this farm"]}
  },
  "syn": {"res": ["irrigation reservoir", "irrigation pond", "storage lagoon"],
          "ext": ["extension", "added strip", "annex plot"]},
  "drop": {"attribute": "reservoir_drop", "part": "reservoir_reading", "dim": "volume", "step": 100, "lo": 20000,
           "hi": 90000, "units": ["m3", "L"], "t_lo": 5000, "t_hi": 20000, "t_step": 500, "t_units": ["m3", "L"],
           "spread": 15000, "cues": ["irrigation reservoir", "irrigation pond", "storage lagoon"],
           "prose": ["On {date}, the {res} at {ref} held {qty}.",
                     "A gauge reading on {date} put the {res} at {ref} at {qty}.",
                     "{Ref}'s {res} contained {qty} on {date}.",
                     "The {res} was measured at {qty} on {date}."],
           "log": ["{date} | {res} | gauge reading | {qty}", "{date} | {res} | volume | {qty}"]},
  "level": {"attribute": "trial_area", "base": "main_plot", "offset": "extension_area", "dim": "area", "step": 100,
            "base_lo": 5000, "base_hi": 40000, "base_units": ["ha", "m2"], "off_lo": 200, "off_hi": 4900,
            "off_units": ["m2", "ha"], "t_lo": 15000, "t_hi": 32000, "t_step": 500, "t_units": ["ha", "m2"],
            "base_cues": ["main plot", "main trial plot"], "offset_cues": ["extension", "added strip", "annex plot"],
            "base_prose": ["The main trial plot at {ref} covers {qty}.",
                           "{Ref}'s main plot measures {qty}.",
                           "Surveyors recorded the main plot at {ref} as {qty}."],
            "offset_prose": ["The {ext} along the eastern headland covers {qty}.",
                             "Along the eastern headland, the {ext} adds {qty}.",
                             "{Ref} later gained {qty} through its {ext}."],
            "base_log": ["{kind} | main plot area | {qty}"],
            "offset_log": ["{kind} | {ext} area | {qty}"]},
  "plain": {
    "region": {"prose": ["{Ref} lies in the {region}.", "{Ref} is farmed in the {region}."],
               "log": ["{kind} | region | {region}"]},
    "lead": {"prose": ["{lead} is the trial lead at {ref}.", "Trials at {ref} are run by {lead}."],
             "log": ["{kind} | trial lead | {lead}"]},
    "crew": {"prose": ["{Ref} has a field team of {crew}.", "A field team of {crew} works {ref}."],
             "log": ["{kind} | field team | {crew}"]},
    "code": {"prose": ["{Ref} is registered under plot code {code}.", "The plot code of {ref} is {code}."],
             "log": ["{kind} | plot code | {code}"]}
  },
  "distractors": [
    {"dim": "volume", "lo": 95000, "hi": 200000, "step": 1000, "units": ["m3"], "date": false, "other": false,
     "prose": "The {res} can hold {qty} when full.", "log": "{kind} | {res} capacity | {qty}"},
    {"dim": "volume", "lo": 200, "hi": 3000, "step": 50, "units": ["L"], "date": true, "other": false,
     "prose": "On {date}, {qty} of spray mix was applied to the guard rows.",
     "log": "{date} | spraying | guard rows | {qty}"},
    {"dim": "volume", "lo": 3000, "hi": 12000, "step": 100, "units": ["L", "m3"], "date": true, "other": true,
     "prose": "On {date}, {other} lent a bowser carrying {qty}.", "log": "{date} | loan | bowser from {other} | {qty}"},
    {"dim": "area", "lo": 300, "hi": 2000, "step": 50, "units": ["m2"], "date": false, "other": false,
     "prose": "The car park beside the gate covers {qty}.", "log": "{kind} | car park area | {qty}"},
    {"dim": "area", "lo": 100, "hi": 900, "step": 10, "units": ["m2"], "date": false, "other": true,
     "prose": "{Other}'s seed store covers {qty}.", "log": "{kind} | seed store at {other} | {qty}"},
    {"dim": "length", "lo": 200, "hi": 3000, "step": 50, "units": ["m"], "date": true, "other": true,
     "prose": "On {date}, staff from {other} walked {qty} of field drains with the team.",
     "log": "{date} | drains walked with {other} | {qty}"},
    {"dim": "area", "lo": 20, "hi": 190, "step": 10, "units": ["m2"], "date": false, "other": false,
     "prose": "The weather enclosure takes up {qty}.", "log": "{kind} | weather enclosure | {qty}"},
    {"dim": "volume", "lo": 1000, "hi": 5000, "step": 100, "units": ["L"], "date": false, "other": true,
     "prose": "{Other} keeps a header tank of {qty} for its sprayers.", "log": "{kind} | header tank at {other} | {qty}"}
  ],
  "filler": {
    "templates": ["{who} {did} the {thing} {when}.", "{weather} {wverb} the {place} {when}.",
                  "{who} noted that the {place} was {state}.", "There was {sighting} near the {place} {when}.",
                  "{who} spent the {period} {activity}.", "The {thing} needed {fix} after {event}.",
                  "{who} reminded the team to {chore} before {event2}."],
    "slots": {
      "who": ["The trial technician", "A summer student", "The agronomist", "The farm manager", "A visiting inspector",
              "The sprayer operator", "The field assistant", "The site manager", "A seed company rep",
              "The data steward"],
      "did": ["checked", "photographed", "weeded", "staked", "labelled", "inspected", "scored", "sampled", "mapped",
              "cleaned"],
      "thing": ["guard rows", "plot markers", "rain gauge", "soil probe", "seed drill", "bird scarer", "data logger",
                "sample bags", "drainage ditch", "hedge line", "gate latch", "sprayer boom"],
      "when": ["in the morning", "after lunch", "before dusk", "at first light", "during the afternoon",
               "late in the evening", "over the weekend", "between showers", "after the team briefing"],
      "weather": ["Low cloud", "Steady drizzle", "Bright sunshine", "A cold north wind", "Thick fog", "Light frost",
                  "Heavy showers", "A warm southerly", "Hard frost", "Gusty rain"],
      "wverb": ["covered", "hung over", "swept across", "returned to", "cleared from", "settled on"],
      "place": ["headland", "north boundary", "tramlines", "guard strip", "gateway", "pond edge", "hedge bank",
                "soil pit", "machinery shed", "farm office"],
      "state": ["waterlogged", "in good order", "dry and firm", "muddy", "frosted over", "patchy",
                "covered in leaves", "rutted by the tractor", "quiet", "freshly mown"],
      "sighting": ["a pair of buzzards", "fresh rabbit damage", "a hare", "pigeon damage", "a roe deer", "a pair of lapwings",
                   "a fox", "some slug damage", "a kestrel hovering", "a family of partridges"],
      "period": ["morning", "afternoon", "evening", "whole day"],
      "activity": ["scoring disease on the plots", "entering data", "calibrating the sprayer", "cleaning sample bags",
                   "writing up the trial diary", "checking plot labels", "preparing seed packets", "mending the fence"],
      "fix": ["fresh grease", "a new bolt", "a coat of paint", "careful cleaning", "a spare part", "a temporary patch"],
      "event": ["the overnight storm", "a heavy frost", "the long dry spell", "a gale", "the harvest",
                "the heavy rain"],
      "chore": ["wash their boots", "log every spray pass", "close the gates", "check the bird scarer",
                "return the sample bags"],
      "event2": ["the open day", "the weekend", "the forecast storm", "the inspection visit", "harvest"]
    }
  },
  "noise": {
    "templates": ["{date} | {system} | {event} | {status}", "{date} | {system} | {event} | {status}",
                  "{date} | note | {remark}", "## {garble} ##", "-- {shift} --"],
    "slots": {
      "system": ["sprayer", "data logger", "rain gauge", "soil probe", "tractor", "bird scarer", "gate", "seed drill",
                 "pump", "weather enclosure"],
      "event": ["routine check", "restart", "calibration", "cleaning", "battery swap", "inspection", "reset",
                "visual check", "service"],
      "status": ["ok", "done", "pass", "noted", "fault cleared", "retry ok", "no fault"],
      "remark": ["plots waterlogged", "gate left open", "hare in the tramlines", "sprayer washed", "labels replaced",
                 "fog all morning", "visitors on site", "drain cleared"],
      "garble": ["line unreadable", "checksum mismatch", "entry overwritten", "duplicate entry removed",
                 "logger timeout", "clock drift corrected", "partial write"],
      "shift": ["handover", "team briefing", "day ends", "day begins"]
    }
  },
  "questions": {
    "agg": "Which trial sites meet both of these conditions? (1) The water in the site's irrigation reservoir (some documents call it an irrigation pond or a storage lagoon) fell by more than {t1} from the earlier of its two dated readings to the later one. (2) The site's total trial area is larger than {t2}, counting the main plot plus its extension (some documents say added strip or annex plot).",
    "join": "Exactly one trial site's irrigation reservoir (some documents call it an irrigation pond or a storage lagoon) lost more than {t1} of water from the earlier of its two dated readings to the later one. Which partner farm has a total trial area exactly equal to that site's, counting for each the main plot plus its extension (some documents say added strip or annex plot)? Answer with the trial site and then the partner farm."
  }
}
