{
  "domain": "field",
  "titles": {"report": "Field report: {name}", "email": "Thread: {name}"},
  "email_domain": "fieldnet.example",
  "types": {
    "A": {"kind": "station", "plural": "stations", "suffix": "Station", "log_title": "STATION LOG", "code_prefix": "FS",
          "stems1": ["Alder", "Birch", "Cedar", "Larch", "Willow", "Hazel", "Juniper", "Aspen", "Elder", "Holly", "Laurel",
                     "Myrtle", "Sorrel", "Tamarack", "Yarrow", "Bracken", "Thistle", "Fennel", "Mallow", "Sedge",
                     "Clover", "Gorse", "Linden", "Poplar", "Spruce", "Hemlock", "Bramble", "Rushwood"],
          "stems2": ["Ridge", "Hollow", "Crag", "Tarn", "Fell", "Combe", "Saddle", "Knoll", "Scar", "Brae", "Gill", "Edge"],
          "alias_forms": ["{stem}", "{stem} field station"], "generic": ["the station", "this station"]},
    "B": {"kind": "depot", "plural": "depots", "suffix": "Depot", "log_title": "DEPOT LOG", "code_prefix": "SD",
          "stems1": ["Kestrel", "Merlin", "Plover", "Curlew", "Dunlin", "Lapwing", "Siskin", "Linnet", "Wren", "Osprey",
                     "Heron", "Raven", "Swift", "Martin", "Ptarmigan", "Grouse"],
          "stems2": ["Point", "Gate", "Ford", "Cross", "Yard", "Bank"],
          "alias_forms": ["{stem}", "{stem} supply depot"], "generic": ["the depot", "this depot"]}
  },
  "syn": {"tank": ["rain tank", "cistern", "water butt"], "hut": ["hut", "cabin", "bothy"],
          "mast": ["weather mast", "instrument mast"]},
  "drop": {"attribute": "tank_drop", "part": "tank_reading", "dim": "volume", "step": 10, "lo": 1500, "hi": 9000,
           "units": ["L", "m3"], "t_lo": 600, "t_hi": 2400, "t_step": 100, "t_units": ["L", "m3"], "spread": 2500,
           "cues": ["rain tank", "cistern", "water butt"],
           "prose": ["On {date}, {ref} recorded {qty} of water in its {tank}.",
                     "The {tank} at {ref} held {qty} when it was dipped on {date}.",
                     "A dip of the {tank} on {date} showed {qty} of stored water.",
                     "{Ref} logged {qty} in the {tank} on {date}."],
           "log": ["{date} | {tank} | dip reading | {qty}", "{date} | {tank} | volume | {qty}"]},
  "level": {"attribute": "mast_elevation", "base": "hut_altitude", "offset": "mast_height", "dim": "length", "step": 10,
            "base_lo": 300, "base_hi": 2400, "base_units": ["m", "km"], "off_lo": 10, "off_hi": 90, "off_units": ["m"],
            "t_lo": 900, "t_hi": 1900, "t_step": 50, "t_units": ["m", "km"],
            "base_cues": ["above sea level", "altitude"], "offset_cues": ["weather mast", "instrument mast"],
            "base_prose": ["{Ref}'s {hut} stands {qty} above sea level.",
                           "The {hut} at {ref} sits at an altitude of {qty}.",
                           "Surveyors put the floor of the {hut} at {ref} at {qty} above sea level."],
            "offset_prose": ["The {mast} rises {qty} above the {hut}.",
                             "Measured from the {hut} floor, the {mast} stands {qty} high.",
                             "The top of the {mast} is {qty} above the {hut}."],
            "base_log": ["{kind} | {hut} altitude | {qty}"],
            "offset_log": ["{kind} | {mast} height above {hut} | {qty}"]},
  "plain": {
    "region": {"prose": ["{Ref} lies in the {region}.", "The {hut} at {ref} looks out over the {region}."],
               "log": ["{kind} | region | {region}"]},
    "lead": {"prose": ["{lead} leads the observing team at {ref}.", "The team at {ref} is led by {lead}."],
             "log": ["{kind} | lead observer | {lead}"]},
    "crew": {"prose": ["{Ref} is staffed by a crew of {crew}.", "A crew of {crew} keeps {ref} running."],
             "log": ["{kind} | crew size | {crew}"]},
    "code": {"prose": ["The registry code of {ref} is {code}.", "{Ref} appears in the network registry as {code}."],
             "log": ["{kind} | registry code | {code}"]}
  },
  "distractors": [
    {"dim": "volume", "lo": 3000, "hi": 12000, "step": 500, "units": ["L", "m3"], "date": false, "other": false,
     "prose": "The {tank} is rated to hold {qty} when full.", "log": "{kind} | {tank} rated capacity | {qty}"},
    {"dim": "volume", "lo": 40, "hi": 400, "step": 10, "units": ["L"], "date": true, "other": false,
     "prose": "On {date}, the kitchen's drinking-water drums were topped up with {qty} carried in by hand.",
     "log": "{date} | kitchen drums | topped up | {qty}"},
    {"dim": "volume", "lo": 20, "hi": 200, "step": 10, "units": ["L"], "date": true, "other": true,
     "prose": "On {date}, a party from {other} carried {qty} of drinking water past the {hut}.",
     "log": "{date} | visitors | party from {other} carried water | {qty}"},
    {"dim": "length", "lo": 1000, "hi": 30000, "step": 100, "units": ["km", "m"], "date": false, "other": false,
     "prose": "The nearest sealed road is {qty} from the {hut}.", "log": "{kind} | distance to sealed road | {qty}"},
    {"dim": "length", "lo": 1500, "hi": 20000, "step": 100, "units": ["km"], "date": false, "other": true,
     "prose": "The footpath from here to {other} is {qty} long.", "log": "{kind} | footpath to {other} | {qty}"},
    {"dim": "length", "lo": 4, "hi": 30, "step": 1, "units": ["m"], "date": false, "other": false,
     "prose": "A separate radio aerial on the generator shed is {qty} tall.",
     "log": "{kind} | generator shed aerial | {qty}"},
    {"dim": "volume", "lo": 50, "hi": 400, "step": 10, "units": ["L"], "date": true, "other": true,
     "prose": "On {date}, {other} lent the team a pump that moves {qty} a minute.",
     "log": "{date} | loan | pump from {other} | {qty} per minute"},
    {"dim": "length", "lo": 200, "hi": 2000, "step": 50, "units": ["m"], "date": true, "other": true,
     "prose": "Walkers from {other} reported a rockfall {qty} below the pass on {date}.",
     "log": "{date} | report | rockfall below the pass, per {other} | {qty}"},
    {"dim": "volume", "lo": 100, "hi": 900, "step": 10, "units": ["L"], "date": false, "other": false,
     "prose": "The spare fuel store holds {qty} of paraffin.", "log": "{kind} | paraffin store | {qty}"}
  ],
  "filler": {
    "templates": ["{who} {did} the {thing} {when}.", "{weather} {wverb} the {place} {when}.",
                  "{who} noted that the {place} was {state}.", "There was {sighting} near the {place} {when}.",
                  "{who} spent the {period} {activity}.", "The {thing} needed {fix} after {event}.",
                  "{who} reminded everyone to {chore} before {event2}."],
    "slots": {
      "who": ["The duty observer", "A visiting technician", "The cook", "The deputy lead", "A volunteer",
              "The night watch", "A student helper", "The relief observer", "The camp manager", "A guest researcher",
              "The radio operator", "The safety officer"],
      "did": ["checked", "cleaned", "inspected", "photographed", "repainted", "oiled", "tidied", "re-tightened",
              "swept", "tested", "labelled", "dried out"],
      "thing": ["anemometer", "solar panel", "radio set", "storm shutter", "door hinge", "first aid kit", "snow fence",
                "boardwalk", "guy wire", "generator", "battery bank", "log book", "satellite phone", "weather screen",
                "wind vane", "stove pipe"],
      "when": ["in the morning", "after lunch", "before dusk", "at first light", "during the afternoon",
               "late in the evening", "over the weekend", "while the wind dropped", "between showers",
               "after the radio call"],
      "weather": ["Low cloud", "Steady drizzle", "Bright sunshine", "A cold north wind", "Thick fog", "Light snow",
                  "Hail showers", "A warm southerly", "Hard frost", "Gusty rain"],
      "wverb": ["covered", "hung over", "swept across", "returned to", "cleared from", "settled on", "lingered over"],
      "place": ["north slope", "lower meadow", "helipad", "scree field", "stream crossing", "upper path", "woodshed",
                "veranda", "upper corrie", "moraine", "bog pools", "boulder field", "gully", "outer cairn"],
      "state": ["slippery", "in good order", "partly flooded", "frozen solid", "muddy", "dry and firm",
                "covered in leaves", "blocked by fallen branches", "quiet", "churned up by animals"],
      "sighting": ["a pair of ravens", "a red deer hind", "a trail of fox tracks", "a herd of ibex", "an eagle circling",
                   "a family of stoats", "a dipper", "a band of wild goats", "a hare", "a flock of finches"],
      "period": ["morning", "afternoon", "evening", "whole day"],
      "activity": ["sorting sample bags", "writing up the diary", "repairing the stove", "re-labelling the archive",
                   "cutting firewood", "clearing the drains", "testing the radio", "reading old field notes",
                   "mending gaiters", "packing specimen boxes"],
      "fix": ["fresh grease", "a new bolt", "a coat of paint", "careful cleaning", "a spare part", "a temporary patch",
              "new cable ties"],
      "event": ["the overnight storm", "a heavy frost", "the long dry spell", "a gale", "the thaw", "the dust storm",
                "the heavy snowfall"],
      "chore": ["close the shutters", "log every radio call", "dry their boots", "secure the bins",
                "check the first aid kit", "stack the firewood"],
      "event2": ["the next supply flight", "the weekend", "the forecast storm", "the inspection visit", "nightfall"]
    }
  },
  "noise": {
    "templates": ["{date} | {system} | {event} | {status}", "{date} | {system} | {event} | {status}",
                  "{date} | note | {remark}", "## {garble} ##", "-- {shift} --"],
    "slots": {
      "system": ["radio", "generator", "solar", "anemometer", "comms", "heater", "stove", "door sensor", "datalogger",
                 "beacon", "wind vane", "battery bank"],
      "event": ["routine check", "restart", "self test", "cleaning", "battery swap", "firmware check", "alarm cleared",
                "inspection", "reset", "visual check"],
      "status": ["ok", "done", "pass", "noted", "fault cleared", "retry ok", "no fault"],
      "remark": ["fog all day", "path icy", "radio call made", "visitors left", "stove relit", "boots drying",
                 "deer near helipad", "wind easing", "shutters closed early", "snow on the boardwalk"],
      "garble": ["line unreadable", "checksum mismatch", "entry overwritten", "duplicate entry removed",
                 "sensor bus timeout", "clock drift corrected", "partial write"],
      "shift": ["shift change", "handover", "night watch begins", "night watch ends"]
    }
  },
  "questions": {
    "agg": "Which stations meet both of these conditions? (1) The water stored in the station's rain tank (some documents call it a cistern or a water butt) fell by more than {t1} from the earlier of its two dated tank readings to the later one. (2) The top of the station's weather mast (some documents say instrument mast) stands higher than {t2} above sea level, counting the altitude of the station's hut (or cabin, or bothy) plus the mast's height above the hut.",
    "join": "Exactly one station's rain tank (some documents call it a cistern or a water butt) lost more than {t1} of stored water from the earlier of its two dated tank readings to the later one. Which depot has a weather mast (some documents say instrument mast) whose top stands at exactly the same height above sea level as the top of that station's mast, counting for each the altitude of its hut (or cabin, or bothy) plus the mast's height above the hut? Answer with the station and then the depot."
  }
}
